<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id = "@+id/cellText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background = "@android:drawable/editbox_background"
    android:padding="8dp">

    <TextView
        android:id="@+id/Item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        android:textSize="20sp"
        android:text="PutItemHere"/>

    <TextView
        android:id="@+id/ItemQuant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Qty"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/Item"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ItemLoc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PutLocHere"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/ItemQuant"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>